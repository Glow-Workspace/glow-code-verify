{
  "manifest_version": 3,
  "name": "Glow Code Verify",
  "version": "0.1.1",
  "description": "Verifies that Glow Meet web apps' code matches the signed release manifest \u2014 protects against tampered or injected code.",
  "action": {
    "default_title": "Glow Code Verify",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/default_32.png",
      "48": "icons/default_48.png",
      "64": "icons/default_64.png",
      "128": "icons/default_128.png"
    }
  },
  "icons": {
    "32": "icons/default_32.png",
    "48": "icons/default_48.png",
    "64": "icons/default_64.png",
    "128": "icons/default_128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet-web.glow-im.com/*",
        "https://meet-web.glow-im.com:8443/admin/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://meet-web.glow-im.com/*",
    "https://meet-web.glow-im.com:8443/*"
  ]
}
