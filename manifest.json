{
  "manifest_version": 3,
  "name": "Glow Code Verify",
  "version": "0.1.0",
  "description": "Verifies that the Glow Meet web app's code matches the signed release manifest — protects against tampered or injected code.",
  "action": {
    "default_title": "Glow Code Verify",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/default_32.png",
      "48": "icons/default_48.png",
      "64": "icons/default_64.png",
      "128": "icons/default_128.png"
    }
  },
  "icons": {
    "32": "icons/default_32.png",
    "48": "icons/default_48.png",
    "64": "icons/default_64.png",
    "128": "icons/default_128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.glow-im.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://meet.glow-im.com/*"]
}
